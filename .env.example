# Contoh kredensial notifikasi. SALIN ke .env lalu isi.
#   cp .env.example .env
# File .env di-GITIGNORE — jangan pernah commit rahasia asli.
# Semua opsional: channel default 'console' (dry-run) tidak butuh apa pun.

# --- Telegram (channel=telegram) ---
# Bot token dari @BotFather; chat_id dari @userinfobot atau getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email SMTP (channel=email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Alpaca (broker US, Fase 5b; DEFAULT paper/uang-virtual) ---
# Buat kunci di dashboard Alpaca (paper trading). Live (uang riil) tetap di-gate
# keras oleh execution engine sampai backtest + rekam jejak paper lolos.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
